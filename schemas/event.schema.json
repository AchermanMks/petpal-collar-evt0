{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "petpal/v1/event",
  "title": "PetPal collar event (topic petpal/v1/{device_id}/event, QoS 1)",
  "type": "object",
  "required": ["v", "device_id", "seq", "ts", "type"],
  "properties": {
    "v": {"const": 1},
    "device_id": {"type": "string"},
    "seq": {"type": "integer"},
    "ts": {"type": "integer"},
    "type": {"enum": ["low_battery", "geofence_exit", "geofence_enter", "reboot", "watchdog_reset", "cache_full", "gnss_timeout", "sim_error", "fota_result", "mode_changed", "over_temp"]},
    "data": {"type": "object"}
  }
}
